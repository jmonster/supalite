{
  "name": "supalite-contributions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Verified published @supabase/lite 0.11.0 baseline",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare:baseline": "node scripts/prepare-baseline.mjs",
    "test": "npm run prepare:upgrade && node --test --test-timeout=120000 --test-concurrency=1 test/*.test.mjs",
    "check": "npm test",
    "build": "tsc -p tsconfig.json",
    "prepare:upgrade": "npm run build && node scripts/prepare-upgrade.mjs",
    "test:upgrade": "npm run prepare:upgrade && node --test --test-timeout=120000 --test-concurrency=1 test/upgrade*.test.mjs",
    "test:upgrade:local": "npm run prepare:upgrade && LITE_LOCAL_SUPABASE_TESTS=1 node --test --test-timeout=600000 test/upgrade-local.test.mjs"
  },
  "dependencies": {
    "kysely": "0.28.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.5",
    "@libsql/client": "0.17.4",
    "@supabase/lite": "0.11.0",
    "@supabase/supabase-js": "2.117.2",
    "postgres": "3.4.8",
    "typescript": "5.9.3"
  }
}
