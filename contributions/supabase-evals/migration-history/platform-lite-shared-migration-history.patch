diff --git a/packages/platform-lite/src/project/migrations.ts b/packages/platform-lite/src/project/migrations.ts
new file mode 100644
index 0000000..89afc90
--- /dev/null
+++ b/packages/platform-lite/src/project/migrations.ts
@@ -0,0 +1,67 @@
+import type { PGlite } from '@electric-sql/pglite';
+import { parse } from 'pgsql-parser';
+
+/** Both the HTTP API and the CLI's Postgres-wire path use this ledger. */
+export async function listMigrations(db: PGlite) {
+  const { rows } = await db.query<{ version: string; name: string | null }>(
+    'SELECT version, name FROM supabase_migrations.schema_migrations ORDER BY version'
+  );
+  return rows.map(({ version, name }) => ({
+    version,
+    name: name ?? undefined,
+  }));
+}
+
+export async function applyMigration(
+  db: PGlite,
+  migration: { query: string; name?: string; rollback?: string }
+) {
+  // A submitted COMMIT/ROLLBACK would escape our transaction. Parse only to
+  // reject transaction control; execute the original SQL so utility commands,
+  // SELECT INTO, comments and dollar-quoted function bodies keep PG semantics.
+  const { stmts } = await parse(migration.query);
+  if (
+    stmts.some(
+      (entry: { stmt?: { TransactionStmt?: unknown } }) =>
+        entry.stmt?.TransactionStmt
+    )
+  ) {
+    throw new Error(
+      'Migration SQL must not contain transaction control statements'
+    );
+  }
+
+  // Use PGlite's exclusive transaction callback, not separate BEGIN/COMMIT
+  // calls: concurrent HTTP requests must allocate versions and apply SQL in
+  // the same critical section. A failure rolls back SQL and history together.
+  return db.transaction(async (tx) => {
+    const timestamp = new Date();
+    let version: string;
+    while (true) {
+      version = timestamp.toISOString().replace(/\D/g, '').slice(0, 14);
+      const { rows } = await tx.query(
+        'SELECT 1 FROM supabase_migrations.schema_migrations WHERE version = $1',
+        [version]
+      );
+      if (rows.length === 0) break;
+      // Keep the CLI's YYYYMMDDHHMMSS format across minute/day boundaries.
+      timestamp.setUTCSeconds(timestamp.getUTCSeconds() + 1);
+    }
+
+    // Match the parser's string-literal rules even if earlier SQL changed the
+    // shared session setting. Otherwise a backslash could hide a COMMIT.
+    await tx.exec('SET LOCAL standard_conforming_strings = on');
+    await tx.exec(migration.query);
+    await tx.query(
+      `INSERT INTO supabase_migrations.schema_migrations
+        (version, name, statements, rollback) VALUES ($1, $2, $3, $4)`,
+      [
+        version,
+        migration.name ?? null,
+        [migration.query],
+        migration.rollback === undefined ? null : [migration.rollback],
+      ]
+    );
+    return { version, name: migration.name };
+  });
+}
diff --git a/packages/platform-lite/test/migrations.test.ts b/packages/platform-lite/test/migrations.test.ts
