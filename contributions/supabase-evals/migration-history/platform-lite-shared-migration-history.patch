@@ -0,0 +1,275 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { ensureHistoryTable } from '@supabase/lite';
+import { createPlatform, type PlatformHandle } from '../src/app.js';
+import { request } from './helpers.js';
+
+const ref = 'migrations-proj';
+const path = `/v1/projects/${ref}/database/migrations`;
+
+describe('shared migration history', () => {
+  let platform: PlatformHandle;
+
+  beforeEach(async () => {
+    platform = await createPlatform({ projects: [{ ref }] });
+    // Also lets these regressions exercise the old implementation against the
+    // same real CLI-compatible table, independently of init provisioning.
+    await ensureHistoryTable(platform.getProject(ref)!.app.connection);
+  });
+
+  afterEach(async () => {
+    vi.useRealTimers();
+    await platform.dispose();
+  });
+
+  it('lists the database ledger in version order and sees repairs immediately', async () => {
+    const db = platform.getProject(ref)!.pglite;
+    expect((await request(platform.app, 'GET', path)).data).toEqual([]);
+    await db.query(
+      `INSERT INTO supabase_migrations.schema_migrations (version, name, statements)
+       VALUES ('20260202000000', 'second', ARRAY['SELECT 2']),
+              ('20260101000000', NULL, NULL)`
+    );
+    expect((await request(platform.app, 'GET', path)).data).toEqual([
+      { version: '20260101000000' },
+      { version: '20260202000000', name: 'second' },
+    ]);
+    await db.query(
+      "DELETE FROM supabase_migrations.schema_migrations WHERE version = '20260101000000'"
+    );
+    expect((await request(platform.app, 'GET', path)).data).toEqual([
+      { version: '20260202000000', name: 'second' },
+    ]);
+  });
+
+  it('stores HTTP SQL and optional rollback in the CLI ledger without running rollback', async () => {
+    const query =
+      'CREATE TABLE http_table (id int); INSERT INTO http_table VALUES (1);';
+    const rollback = 'DROP TABLE http_table;';
+    const response = await request<{ version: string; name: string }>(
+      platform.app,
+      'POST',
+      path,
+      { name: 'http_migration', query, rollback }
+    );
+    expect(response.status).toBe(201);
+    expect(response.data).toEqual({
+      version: expect.stringMatching(/^\d{14}$/),
+      name: 'http_migration',
+    });
+    const { rows } = await platform
+      .getProject(ref)!
+      .pglite.query(
+        'SELECT version, name, statements, rollback FROM supabase_migrations.schema_migrations'
+      );
+    expect(rows).toEqual([
+      { ...response.data, statements: [query], rollback: [rollback] },
+    ]);
+    expect(
+      (await platform.getProject(ref)!.pglite.query('SELECT * FROM http_table'))
+        .rows
+    ).toEqual([{ id: 1 }]);
+    expect((await request(platform.app, 'GET', path)).data).toEqual([
+      response.data,
+    ]);
+  });
+
+  it('allows an omitted name and preserves quoted SQL and dollar-quoted bodies', async () => {
+    const query = `
+      CREATE FUNCTION migration_message() RETURNS text LANGUAGE sql AS $$
+        SELECT 'quoted; ''text'' $platform_lite_migration$ $platform_lite_migration__sql$'
+      $$;
+      CREATE TABLE messages AS SELECT migration_message() AS message;
+    `;
+    const response = await request(platform.app, 'POST', path, { query });
+    expect(response.status).toBe(201);
+    expect(response.data).toEqual({
+      version: expect.stringMatching(/^\d{14}$/),
+    });
+    const { rows } = await platform
+      .getProject(ref)!
+      .pglite.query(
+        'SELECT name, statements, rollback FROM supabase_migrations.schema_migrations'
+      );
+    expect(rows).toEqual([{ name: null, statements: [query], rollback: null }]);
+    expect((await request(platform.app, 'GET', path)).data).toEqual([
+      response.data,
+    ]);
+  });
+
+  it('preserves SELECT INTO, nested comments, and transaction words inside SQL strings', async () => {
+    const response = await request(platform.app, 'POST', path, {
+      query: `
+        /* outer comment; /* BEGIN; */ COMMIT; */
+        SELECT 'COMMIT; ROLLBACK; SAVEPOINT x;' AS message INTO select_into_table;
+        DO $$ BEGIN RAISE NOTICE 'BEGIN; COMMIT;'; END $$;
+      `,
+    });
+    expect(response.status).toBe(201);
+    expect(
+      (
+        await platform
+          .getProject(ref)!
+          .pglite.query('SELECT * FROM select_into_table')
+      ).rows
+    ).toEqual([{ message: 'COMMIT; ROLLBACK; SAVEPOINT x;' }]);
+  });
+
+  it('keeps parser and execution string rules aligned after session settings change', async () => {
+    const db = platform.getProject(ref)!.pglite;
+    await db.exec('SET standard_conforming_strings = off');
+    const response = await request(platform.app, 'POST', path, {
+      query: String.raw`CREATE TABLE escaped(id int); SELECT '\'; SELECT '; COMMIT; --';
+        SELECT missing_column;`,
+    });
+    expect(response.status).toBe(400);
+    expect(
+      (await db.query("SELECT to_regclass('escaped') AS relation")).rows
+    ).toEqual([{ relation: null }]);
+    expect((await request(platform.app, 'GET', path)).data).toEqual([]);
+  });
+
+  it('rolls back successful earlier statements when later SQL fails', async () => {
+    const response = await request(platform.app, 'POST', path, {
+      name: 'failed',
+      query: 'CREATE TABLE partial_apply(id int); SELECT missing_column;',
+    });
+    expect(response.status).toBe(400);
+    expect(
+      (
+        await platform
+          .getProject(ref)!
+          .pglite.query("SELECT to_regclass('partial_apply') AS relation")
+      ).rows
+    ).toEqual([{ relation: null }]);
+    expect((await request(platform.app, 'GET', path)).data).toEqual([]);
+  });
+
+  it('rolls back applied SQL when writing its history fails', async () => {
+    const db = platform.getProject(ref)!.pglite;
+    await db.exec(`ALTER TABLE supabase_migrations.schema_migrations
+      ADD CONSTRAINT reject_history CHECK (name <> 'rejected')`);
+    const response = await request(platform.app, 'POST', path, {
+      name: 'rejected',
+      query: 'CREATE TABLE must_rollback(id int)',
+    });
+    expect(response.status).toBe(400);
+    expect(
+      (await db.query("SELECT to_regclass('must_rollback') AS relation")).rows
+    ).toEqual([{ relation: null }]);
+    expect((await request(platform.app, 'GET', path)).data).toEqual([]);
+  });
+
+  it.each([
+    'BEGIN; SELECT 1; COMMIT;',
+    'COMMIT;',
+    'ROLLBACK;',
+    'END;',
+    'ABORT;',
+    'SAVEPOINT migration_savepoint;',
+    'RELEASE SAVEPOINT migration_savepoint;',
+    'ROLLBACK TO SAVEPOINT migration_savepoint;',
+    'START TRANSACTION;',
+    'DO $$ BEGIN COMMIT; END $$;',
+  ])(
+    'does not let transaction control escape atomicity: %s',
+    async (control) => {
+      const response = await request(platform.app, 'POST', path, {
+        name: 'escape',
+        query: `CREATE TABLE escaped(id int); ${control} SELECT missing_column;`,
+      });
+      expect(response.status).toBe(400);
+      expect(
+        (
+          await platform
+            .getProject(ref)!
+            .pglite.query("SELECT to_regclass('escaped') AS relation")
+        ).rows
+      ).toEqual([{ relation: null }]);
+      expect((await request(platform.app, 'GET', path)).data).toEqual([]);
+    }
+  );
+
+  it('allocates distinct versions for concurrent requests without replacing CLI history', async () => {
+    const db = platform.getProject(ref)!.pglite;
+    await db.exec(`CREATE TABLE effects(label text);
+      INSERT INTO supabase_migrations.schema_migrations (version, name)
+      VALUES ('20261003235959', 'cli_one'), ('20261004000000', 'cli_two')`);
+    vi.useFakeTimers({ toFake: ['Date'] });
+    vi.setSystemTime(new Date('2026-10-03T23:59:59Z'));
+    const responses = await Promise.all(
+      Array.from({ length: 4 }, (_, i) =>
+        request<{ version: string }>(platform.app, 'POST', path, {
+          name: `http_${i}`,
+          query: `INSERT INTO effects VALUES ('${i}')`,
+        })
+      )
+    );
+    expect(responses.map((response) => response.status)).toEqual([
+      201, 201, 201, 201,
+    ]);
+    expect(responses.map((response) => response.data.version).sort()).toEqual([
+      '20261004000001',
+      '20261004000002',
+      '20261004000003',
+      '20261004000004',
+    ]);
+    const { rows } = await db.query(
+      'SELECT version, name FROM supabase_migrations.schema_migrations ORDER BY version'
+    );
+    expect(rows.slice(0, 2)).toEqual([
+      { version: '20261003235959', name: 'cli_one' },
+      { version: '20261004000000', name: 'cli_two' },
+    ]);
+    expect(rows).toHaveLength(6);
+    expect((await db.query('SELECT * FROM effects')).rows).toHaveLength(4);
+  });
+
+  it('rejects a SQL uniqueness violation without retrying or recording it', async () => {
+    const db = platform.getProject(ref)!.pglite;
+    await db.exec(
+      'CREATE TABLE unique_values(id int PRIMARY KEY); INSERT INTO unique_values VALUES (1)'
+    );
+    const response = await request(platform.app, 'POST', path, {
+      query:
+        'INSERT INTO unique_values VALUES (2); INSERT INTO unique_values VALUES (1)',
+    });
+    expect(response.status).toBe(400);
+    expect((await db.query('SELECT * FROM unique_values')).rows).toEqual([
+      { id: 1 },
+    ]);
+    expect((await request(platform.app, 'GET', path)).data).toEqual([]);
+  });
+
+  it.each([
+    {},
+    { query: '' },
+    { query: 1 },
+    { query: 'SELECT 1', name: 1 },
+    { query: 'SELECT 1', rollback: 1 },
+  ])('validates the documented migration body: %j', async (body) => {
+    expect((await request(platform.app, 'POST', path, body)).status).toBe(400);
+    expect((await request(platform.app, 'GET', path)).data).toEqual([]);
+  });
+
+  it('rejects malformed JSON and unknown projects', async () => {
+    const response = await platform.app.request(path, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: '{',
+    });
+    expect(response.status).toBe(400);
+    expect(await response.json()).toEqual({ message: 'Invalid JSON body' });
+    for (const method of ['GET', 'POST']) {
+      expect(
+        (
+          await request(
+            platform.app,
+            method,
+            '/v1/projects/missing/database/migrations',
+            method === 'POST' ? { query: 'SELECT 1' } : undefined
+          )
+        ).status
+      ).toBe(404);
+    }
+  });
+});
